SEARXNG_URL=
ASA_DIR=
ASA_AUTHOR_COMMAND=
VECTORCRAFT_DIR=
CODEX_SKILLS_DIR=

# Durable design storage. No local-disk fallback; both prefixes remain private.
DESIGN_S3_BUCKET=
DESIGN_S3_REGION=
DESIGN_S3_ENDPOINT=
DESIGN_S3_PREFIX=sixsummit
DESIGN_S3_FORCE_PATH_STYLE=false
# Leave empty for the AWS default credential chain / instance or task role.
DESIGN_S3_ACCESS_KEY_ID=
DESIGN_S3_SECRET_ACCESS_KEY=
DESIGN_S3_SESSION_TOKEN=
# Temporary authoring outside the checkout; defaults to OS temp/sixsummit-design-work.
DESIGN_WORK_ROOT=

LOGGER_LEVEL=warn
