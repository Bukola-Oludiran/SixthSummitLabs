APP_KEY=
APP_PUBLIC_PATH=/crm/
API_BASE_PATH=/api/
WS_PATH=/ws
PLUGIN_STATICS_PATH=/static/plugins/
TZ=UTC
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=55439
DB_DATABASE=sixsummit_leads
DB_USER=sixsummit
DB_PASSWORD=
INIT_LANG=en-US
INIT_ROOT_EMAIL=admin@6ixsummitlabs.local
INIT_ROOT_USERNAME=sixsummit
INIT_ROOT_NICKNAME=6ixSummit Admin
INIT_ROOT_PASSWORD=
NOCOBASE_URL=http://127.0.0.1:13000/crm
PUBLIC_SITE_URL=http://127.0.0.1:5173
PROSPECT_PORT=13010
NOCOBASE_API_KEY=
NOCOBASE_REPORTING_API_KEY=
