{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixthsummitlabs",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/crm", "/crm/*", "/designs", "/designs/*",
      "/prospect-api", "/prospect-api/*", "/global.css", "/browser-checker.js"
    ]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://sixthsummitlabs-production.up.railway.app"
  }
}
