# Include within nginx's http context. Replace the hostname and static root.
map $http_upgrade $sixsummit_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name 6ixsummitlabs.com;
    root /srv/sixsummit/site/dist;
    index index.html;

    location = /crm { return 302 /crm/admin/sixsummit; }
    location = /crm/ { return 302 /crm/admin/sixsummit; }

    location ^~ /crm/ {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sixsummit_connection_upgrade;
        proxy_read_timeout 300s;
    }

    location ^~ /prospect-api/ {
        proxy_pass http://127.0.0.1:13010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /designs {
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    location ^~ /designs/ {
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    location / { try_files $uri $uri/ /index.html; }
}
